# Copy this file to .env and fill in your Azure OpenAI values.
# .env is gitignored; do not commit real keys.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional: HTTP timeout in seconds for Azure OpenAI client (omit for SDK default, often 600).
# AZURE_OPENAI_TIMEOUT_SECONDS=600

# Optional: max completion tokens (raise if you see empty output and finish_reason=length).
# Single-shot selection (default 8192):
# AZURE_OPENAI_SELECTION_MAX_COMPLETION_TOKENS=8192
# Two-stage: Stage 1 = wide candidate list (default 16384); Stage 2 = final paths (default 8192)
# AZURE_OPENAI_STAGE1_MAX_COMPLETION_TOKENS=16384
# AZURE_OPENAI_STAGE2_MAX_COMPLETION_TOKENS=8192

# Two-stage only: max total characters of spec snippets in Stage 2 (split across Stage-1 candidates).
# Prevents ~60k-token prompts when Stage 1 returns many paths. Default 100000.
# STAGE2_MAX_TOTAL_SNIPPET_CHARS=100000

# Reasoning models (e.g. gpt-5-mini) may spend completion_tokens on reasoning_tokens only — raise this
# so visible paths can still be emitted (default 16384). Try 32768 if Stage 2 message.content stays empty.
# For Azure gpt-4o, max completion output is often 16384 — values above that return HTTP 400.
# AZURE_OPENAI_STAGE2_MAX_COMPLETION_TOKENS=16384

# If Stage 2 returns empty text, fall back to Stage 1 candidate paths (wide net — many tests).
# STAGE2_FALLBACK_STAGE1=1

# Stage 2 width is controlled on the CLI (not .env): default = precision; add --stage2-balanced for
# slightly more tests; --stage2-recall for the widest list. Example:
#   python select_tests.py --repo ... --base ... --head ... --two-stage --stage2-balanced

# Optional: set to 1 for extra stderr logging (raw content preview when whitespace-only).
# SELECT_TESTS_VERBOSE_AZURE=1
